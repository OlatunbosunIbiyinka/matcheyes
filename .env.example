# Copy to .env for local development. Never commit .env.
# In Azure, these come from app settings / Key Vault references and Managed Identity — not secrets in files.

MATCHEYES_ENV=local
MATCHEYES_LOG_LEVEL=INFO

# Populated from Stage 3 onwards (Microsoft Foundry model access).
# Authentication uses DefaultAzureCredential (az login locally, Managed Identity in Azure); no API keys.
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_MODEL_DEPLOYMENT_NAME=
